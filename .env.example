# OpenStore — environment template. Copy to `.env` and fill in.
#
# `.env` is never committed. In a real install `scripts/openstore_up.py` writes
# it at first boot and generates every secret; nothing here is hand-written on a
# Merchant's machine (SPECS/PLAN.md §16.1, SPEC §14).
#
# Every variable is named here with NO VALUE. A template that ships a working
# secret is how that secret reaches production.

# ── Identity and origin (§16.1) ────────────────────────────────────────────────
# One origin, because passkeys are bound to it. The RP ID is the Merchant domain
# and nothing else: enrollment is per domain (ADR-0008), so this value decides
# which credentials exist.
OPENSTORE_MERCHANT_DOMAIN=
OPENSTORE_PUBLIC_ORIGIN=
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=

# ── Service wiring (§16.1) ─────────────────────────────────────────────────────
# store :3000, sidecar :8000, buyer-chat :3001, postgres :5432, Caddy :80.
SIDECAR_PORT=
STORE_PORT=
STORE_INTERNAL_URL=

# ── Databases ──────────────────────────────────────────────────────────────────
# Two databases, two roles, and NO cross-grant: a test asserts `sc_app` cannot
# SELECT any `spoiledduckie` table. The sidecar never shares a DB with the
# Merchant, demo included (SPEC §5).
SIDECAR_DATABASE_URL=
MERCHANT_DATABASE_URL=

# ── Merchant-truth trait (the 9 doors) ─────────────────────────────────────────
# HMAC-SHA256 over the raw body, 60s replay window plus a nonce.
TRAIT_BASE_URL=
TRAIT_HMAC_SECRET=

# ── Signing keys (ADR-0014) ────────────────────────────────────────────────────
# Generated in the sidecar and never leaving it. Rotation is additive by `kid`;
# recovery is only from the Merchant's own encrypted enrollment export, and
# first run refuses to continue until that export is acknowledged as saved.
SIDECAR_SIGNING_KEY_PATH=
SIDECAR_SIGNING_KEY_PASSPHRASE=
SIDECAR_KEY_EXPORT_PATH=

# Per-deployment pseudonym key: `consumer_id` = HMAC(this, payer_handle), so the
# identifier is per Merchant domain and never correlates a Consumer across
# stores (ADR-0011).
DEPLOY_PSEUDONYM_KEY=

# ── Payment Provider (the Merchant's own account, ADR-0013) ────────────────────
# `fake` is the demo default and declares every method. Razorpay declares UPI
# and REFUSES TO BOOT on a live (non-`rzp_test_`) key while demo mode is on.
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Agent admission (ADR-0012) ─────────────────────────────────────────────────
# OAuth client-credentials for an allowlisted agent; strangers self-register by
# publishing an Agent Profile and are issued a short token on the spot.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# THE SSRF EXCEPTION, AND IT IS EXACTLY ONE.
# Empty by default. Dev only. Comma-separated host[:port] entries — NEVER a CIDR
# and never a blanket "allow private" — so the compose demo can admit its own
# chat at `buyer-chat:3001`. The cloud metadata address (169.254.169.254) stays
# refused unconditionally even here; resolve-then-pin, the redirect ban and the
# size and timeout caps still apply; every fetch that uses it logs a warning and
# is flagged in health output and the /agentic banner; and the sidecar REFUSES
# TO BOOT if this is non-empty alongside live provider keys. A bypass that is
# silent, broad, or bootable in production is how bypasses reach production.
OPENSTORE_DEV_PROFILE_HOSTS=

# ── Demo (§16.1) ───────────────────────────────────────────────────────────────
# The install script writes the seeded admin password here and prints it once.
OPENSTORE_DEMO_MODE=
ADMIN_SEED_PASSWORD=

# ── Buyer chat (Surface 3, its own process and its own everything) ─────────────
# Air-gapped stranger: zero sidecar imports, HTTP only. `scripted` is the
# default driver and is what CI runs; every other driver is optional and none is
# ever required — a demo that needs somebody's API key to pass its own tests is
# one that fails on the next laptop.
#
# `openrouter` is the real-model driver: one API over many providers, so the
# demo is not tied to one vendor. The model **proposes**; deterministic code
# still validates every call and the sidecar still refuses anything the Merchant
# would not allow, so a wrong model costs a refusal rather than a wrong charge.
CHAT_MODEL_DRIVER=
CHAT_DATABASE_PATH=
CHAT_KEY_PATH=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
ANTHROPIC_API_KEY=
