{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"moduleResolution": "bundler",
		"module": "esnext",
		"target": "es2022",
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"esModuleInterop": true,
		"skipLibCheck": true
	}
}
